diff --git a/backend/orchestrator/service.py b/backend/orchestrator/service.py
index f2a285e..10583f8 100644
--- a/backend/orchestrator/service.py
+++ b/backend/orchestrator/service.py
@@ -22,14 +22,81 @@ from core.models import (
     CampaignStatus,
     Channel,
     ConversationTurn,
+    DecisionVerdict,
     Direction,
     FunnelStage,
     Prospect,
 )
+from integrations.sms import send_sms
 from orchestrator import state_machine as sm
 
 converse_agent = ConverseAgent()
 
+# Channels with a real connector wired up in dispatch_send(). Everything else
+# stays decision-only (drafted + logged, never actually delivered) until its
+# connector is built — see the module docstring on integrations/.
+_CONNECTED_CHANNELS = {Channel.SMS}
+
+
+async def dispatch_send(
+    session: AsyncSession,
+    campaign: Campaign,
+    link: CampaignProspectLink,
+    prospect: Prospect,
+    decision: AgentDecision,
+) -> dict:
+    """Turn a Personalize SEND decision into an actual outbound message for
+    channels that have a real connector, and record what really happened.
+
+    This is the "orchestrator turns SEND into a connector call" step the
+    agents' docstrings describe as not built yet — built here, for SMS first.
+    Safe to call on any decision: no-ops cleanly for WAIT verdicts or for
+    channels without a connector yet.
+    """
+    details = decision.details or {}
+    if decision.verdict != DecisionVerdict.SEND:
+        return {"delivered": False, "reason": "verdict is not SEND"}
+
+    channel_value = details.get("channel")
+    try:
+        channel = Channel(channel_value) if channel_value else None
+    except ValueError:
+        channel = None
+
+    if channel not in _CONNECTED_CHANNELS:
+        return {"delivered": False, "reason": f"no connector wired up for channel '{channel_value}' yet"}
+
+    to_number = next(iter(prospect.profile.phone_numbers), None)
+    if not to_number:
+        return {"delivered": False, "reason": "prospect has no phone number on file"}
+
+    result = await send_sms(to=to_number, body=details.get("draft_message") or "")
+    details["sms_result"] = {
+        "sent": result.sent, "provider": result.provider,
+        "message_id": result.message_id, "error": result.error,
+    }
+
+    await repo.append_turn(session, ConversationTurn(
+        campaign_id=campaign.id, prospect_id=prospect.id,
+        channel=Channel.SMS, direction=Direction.OUTBOUND,
+        content=details.get("draft_message") or "",
+        agent_name="personalize", prompt_version_id=decision.prompt_version_id,
+    ))
+
+    if result.sent and link.stage == FunnelStage.QUALIFIED:
+        try:
+            sm.transition(link, FunnelStage.CONTACTED, campaign)
+            link.last_contacted_channel = Channel.SMS.value
+            link.contact_count += 1
+            await repo.save_link(session, link)
+        except (sm.InvalidTransitionError, sm.CampaignNotLiveError):
+            pass
+
+    return {
+        "delivered": result.sent, "provider": result.provider,
+        "message_id": result.message_id, "error": result.error,
+    }
+
 
 async def process_converse(
     session: AsyncSession,
