+# Copy to backend/.env and fill in. Nothing here is required to boot the app —
+# every integration below has a safe fallback (mock/template) when its
+# variables are missing, so you can run locally with an empty .env.
+
+# --- Database (Postgres via SQLAlchemy) --------------------------------------
+DATABASE_URL=               # pooled/async connection string, used by the running app
+DIRECT_URL=                 # direct connection string, used by Alembic migrations + APScheduler's jobstore
+SQL_ECHO=false
+
+# --- Auth ---------------------------------------------------------------------
+JWT_SECRET=change-me
+
+# --- Research agent (optional LLM upgrade) -------------------------------------
+RESEARCH_EMBEDDING_BACKEND=tfidf   # or "sentence_transformers" (downloads a ~90MB model)
+
+# --- Personalize agent drafting (optional; falls back to templates) -----------
+GEMINI_API_KEY=
+GROQ_API_KEY=
+
+# --- SMS sending (backend/integrations/sms.py) ---------------------------------
+# SMS_PROVIDER selects the connector explicitly: "twilio" | "textbelt" | "mock".
+# Leave unset to auto-detect: a real Twilio account is used if all three
+# TWILIO_* values below are set to real (non-placeholder) values, otherwise it
+# falls back to Textbelt's free, no-signup shared demo key — a genuinely real
+# text send with zero setup, capped at 1 SMS/day shared globally across
+# everyone using that key. Set TEXTBELT_API_KEY to a purchased key to lift
+# that cap. SMS_PROVIDER=mock forces a logged-only fake send.
+SMS_PROVIDER=
+TWILIO_ACCOUNT_SID=
+TWILIO_AUTH_TOKEN=
+TWILIO_SMS_FROM_NUMBER=
+TEXTBELT_API_KEY=
+
+# --- Deployment -----------------------------------------------------------------
+VERCEL=                      # set by Vercel automatically; leave blank locally
