--- /dev/null
+++ b/backend/integrations/sms.py
@@ -0,0 +1,117 @@
+"""Real SMS sending.
+
+Provider is picked at call time from environment variables, in this priority
+order (mirrors the SMS_PROVIDER pattern used by the team's other buildathon
+service, so the same mental model applies to both codebases):
+
+  1. ``twilio``   — real, needs a purchased Twilio number + real
+                    TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN. Used automatically
+                    whenever those look like real (non-empty, non-placeholder)
+                    values, regardless of SMS_PROVIDER.
+  2. ``textbelt`` — real delivery via textbelt.com, no signup required. Uses
+                    the public shared demo key ``"textbelt"`` (capped at 1 SMS
+                    per day, shared globally across everyone using that key)
+                    unless TEXTBELT_API_KEY is set to a purchased key. This is
+                    the default when no Twilio credentials are configured, so
+                    a fresh checkout of this repo can send a genuine text
+                    without anyone signing up for anything.
+  3. ``mock``     — no network call; logs only. Used when SMS_PROVIDER=mock is
+                    set explicitly, or as the final fallback if a real send
+                    errors out, so a demo run never hard-crashes on a flaky
+                    provider.
+
+Every outcome — including a mock send — is reported back as an SmsResult so
+callers can record honestly what happened (never claim "sent" when nothing
+left the building).
+"""
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Optional
+
+import httpx
+
+_PLACEHOLDER_MARKERS = ("your_", "xxxx", "changeme", "placeholder", "example")
+
+
+def _looks_real(value: Optional[str]) -> bool:
+    if not value:
+        return False
+    lowered = value.strip().lower()
+    if not lowered:
+        return False
+    return not any(marker in lowered for marker in _PLACEHOLDER_MARKERS)
+
+
+@dataclass
+class SmsResult:
+    sent: bool
+    provider: str              # "twilio" | "textbelt" | "mock"
+    to: str
+    message_id: Optional[str] = None
+    error: Optional[str] = None
+
+
+def _select_provider() -> str:
+    forced = (os.getenv("SMS_PROVIDER") or "").strip().lower()
+    if forced in ("twilio", "textbelt", "mock"):
+        return forced
+    # Auto-detect: prefer a real Twilio account if one is actually configured.
+    if _looks_real(os.getenv("TWILIO_ACCOUNT_SID")) and _looks_real(os.getenv("TWILIO_AUTH_TOKEN")) \
+            and _looks_real(os.getenv("TWILIO_SMS_FROM_NUMBER")):
+        return "twilio"
+    return "textbelt"
+
+
+async def _send_twilio(to: str, body: str) -> SmsResult:
+    sid = os.getenv("TWILIO_ACCOUNT_SID", "")
+    token = os.getenv("TWILIO_AUTH_TOKEN", "")
+    from_number = os.getenv("TWILIO_SMS_FROM_NUMBER", "")
+    url = f"https://api.twilio.com/2010-04-01/Accounts/{sid}/Messages.json"
+    async with httpx.AsyncClient(timeout=15.0) as client:
+        resp = await client.post(
+            url,
+            auth=(sid, token),
+            data={"To": to, "From": from_number, "Body": body},
+        )
+    if resp.status_code >= 400:
+        return SmsResult(sent=False, provider="twilio", to=to, error=f"HTTP {resp.status_code}: {resp.text[:300]}")
+    payload = resp.json()
+    return SmsResult(sent=True, provider="twilio", to=to, message_id=payload.get("sid"))
+
+
+async def _send_textbelt(to: str, body: str) -> SmsResult:
+    key = os.getenv("TEXTBELT_API_KEY", "textbelt")  # shared free demo key by default
+    async with httpx.AsyncClient(timeout=15.0) as client:
+        resp = await client.post(
+            "https://textbelt.com/text",
+            data={"phone": to, "message": body, "key": key},
+        )
+    payload = resp.json() if resp.headers.get("content-type", "").startswith("application/json") else {}
+    if not payload.get("success"):
+        return SmsResult(sent=False, provider="textbelt", to=to, error=payload.get("error") or f"HTTP {resp.status_code}")
+    return SmsResult(sent=True, provider="textbelt", to=to, message_id=str(payload.get("textId")))
+
+
+def _send_mock(to: str, body: str, *, reason: Optional[str] = None) -> SmsResult:
+    print(f"[sms:mock] to={to} body={body!r}" + (f" (fallback reason: {reason})" if reason else ""))
+    return SmsResult(sent=False, provider="mock", to=to, error=reason or "mock provider — no real send configured")
+
+
+async def send_sms(to: str, body: str) -> SmsResult:
+    """Send a real SMS if a real provider is configured, else fall back to a
+    clearly-labeled mock. Never raises — network/provider errors come back as
+    a failed SmsResult so a single bad send can't take down a pipeline run."""
+    if not to:
+        return SmsResult(sent=False, provider="mock", to="", error="prospect has no phone number on file")
+
+    provider = _select_provider()
+    try:
+        if provider == "twilio":
+            return await _send_twilio(to, body)
+        if provider == "textbelt":
+            return await _send_textbelt(to, body)
+        return _send_mock(to, body)
+    except Exception as exc:  # noqa: BLE001 — a demo run must never crash on a provider hiccup
+        return _send_mock(to, body, reason=f"{provider} send failed: {exc}")
