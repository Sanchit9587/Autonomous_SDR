+"""Unit tests for the meeting-booking pipeline (integrations + the pure
+scheduling helper). No DB, no network, no real Google/SMTP credentials —
+these exercise the dev-fallback ("stub") paths that let the app run out of
+the box, same as the rest of this codebase's tests would for e.g. the TF-IDF
+fallback embedding backend.
+"""
+from __future__ import annotations
+
+import os
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from integrations.calendar import GoogleCalendarClient
+from integrations.mailer import EmailSender
+from orchestrator.meeting_scheduler import DEFAULT_LEAD_DAYS, _next_slot
+
+
+# --- GoogleCalendarClient: dev fallback (no credentials configured) --------
+def test_calendar_client_without_credentials_returns_stub_meet_link():
+    client = GoogleCalendarClient(service_account_json=None)
+    assert client.is_configured() is False
+
+    start = datetime(2026, 9, 22, 15, 0, tzinfo=timezone.utc)
+    event = client.create_meeting_event(
+        admin_email="admin@sdrhq.io",
+        participant_email="prospect@example.com",
+        participant_name="Jamie Prospect",
+        summary="Intro call",
+        description="test",
+        start=start,
+        duration_minutes=30,
+    )
+
+    assert event.is_stub is True
+    assert event.meet_link.startswith("https://meet.google.com/")
+    assert event.start == start
+    assert event.end == start + timedelta(minutes=30)
+    assert event.event_id.startswith("stub_")
+
+
+def test_calendar_client_is_configured_when_credentials_present():
+    client = GoogleCalendarClient(service_account_json='{"type": "service_account"}')
+    assert client.is_configured() is True
+
+
+# --- EmailSender: dev fallback (no SMTP configured) ------------------------
+def test_email_sender_without_smtp_logs_instead_of_sending():
+    sender = EmailSender(host=None, username=None, password=None)
+    assert sender.is_configured() is False
+
+    start = datetime(2026, 9, 22, 15, 0, tzinfo=timezone.utc)
+    end = start + timedelta(minutes=30)
+    result = sender.send_meeting_invite(
+        to_email="prospect@example.com", to_name="Jamie Prospect",
+        meet_link="https://meet.google.com/abc-defg-hij",
+        start=start, end=end,
+        admin_name="Ava Chen", admin_email="ava@sdrhq.io", campaign_name="Q4 Outbound",
+    )
+
+    assert result.sent is False
+    assert result.is_stub is True
+    assert result.to == "prospect@example.com"
+    assert "Q4 Outbound" in result.subject
+
+
+def test_email_sender_is_configured_when_smtp_env_present():
+    sender = EmailSender(host="smtp.gmail.com", username="me@sdrhq.io", password="app-password")
+    assert sender.is_configured() is True
+
+
+# --- _next_slot: deterministic default meeting time -------------------------
+def test_next_slot_lands_on_a_weekday_at_the_configured_hour():
+    # A Friday -> with 1 business day lead, should land on Monday (skips the weekend).
+    friday = datetime(2026, 9, 25, 10, 0, tzinfo=timezone.utc)  # 2026-09-25 is a Friday
+    slot = _next_slot(now=friday)
+
+    assert slot.weekday() < 5  # Mon-Fri
+    assert slot > friday
+    if DEFAULT_LEAD_DAYS == 1:
+        assert slot.date() == datetime(2026, 9, 28, tzinfo=timezone.utc).date()  # the following Monday
