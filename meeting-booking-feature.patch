new file mode 100644
index 0000000..ddccec7
--- /dev/null
+++ b/backend/integrations/mailer.py
@@ -0,0 +1,111 @@
+"""Sends the participant-facing meeting email: the Google Meet link + a
+reminder of when the meeting is.
+
+Env vars:
+  SMTP_HOST, SMTP_PORT (default 587), SMTP_USER, SMTP_PASSWORD, SMTP_FROM
+  (defaults to SMTP_USER), SMTP_USE_TLS (default "true").
+
+  Works as-is against Gmail SMTP (smtp.gmail.com:587 + an app password) or
+  any standard SMTP relay.
+
+Dev fallback: if SMTP_HOST/SMTP_USER/SMTP_PASSWORD aren't all set, the email
+is logged instead of sent, so the pipeline runs end to end without live SMTP
+credentials — same pattern as integrations/calendar.py's stub mode.
+"""
+from __future__ import annotations
+
+import logging
+import os
+import smtplib
+from dataclasses import dataclass
+from datetime import datetime
+from email.message import EmailMessage
+from typing import Optional
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class EmailResult:
+    sent: bool
+    to: str
+    subject: str
+    is_stub: bool = False
+
+
+def _format_meeting_email(
+    *, to_name: str, meet_link: str, start: datetime, end: datetime,
+    admin_name: str, admin_email: str, campaign_name: str,
+) -> tuple[str, str]:
+    subject = f"Meeting confirmed: {campaign_name} — {start.strftime('%a %d %b, %H:%M UTC')}"
+    body = (
+        f"Hi {to_name or 'there'},\n\n"
+        f"Your meeting with {admin_name} ({admin_email}) is confirmed.\n\n"
+        f"When:  {start.strftime('%A, %d %B %Y, %H:%M')} - {end.strftime('%H:%M')} UTC\n"
+        f"Where: Google Meet — {meet_link}\n\n"
+        f"This is a reminder to join a few minutes early. Reply to this email if you "
+        f"need to reschedule.\n\n"
+        f"See you there,\n{admin_name}"
+    )
+    return subject, body
+
+
+class EmailSender:
+    def __init__(
+        self, *,
+        host: Optional[str] = None, port: Optional[int] = None,
+        username: Optional[str] = None, password: Optional[str] = None,
+        sender: Optional[str] = None, use_tls: Optional[bool] = None,
+    ) -> None:
+        self._host = host or os.getenv("SMTP_HOST")
+        self._port = port or int(os.getenv("SMTP_PORT", "587"))
+        self._username = username or os.getenv("SMTP_USER")
+        self._password = password or os.getenv("SMTP_PASSWORD")
+        self._sender = sender or os.getenv("SMTP_FROM") or self._username or "sdr@sdrhq.io"
+        self._use_tls = use_tls if use_tls is not None else os.getenv("SMTP_USE_TLS", "true").lower() != "false"
+
+    def is_configured(self) -> bool:
+        return bool(self._host and self._username and self._password)
+
+    def send_meeting_invite(
+        self, *,
+        to_email: str, to_name: str, meet_link: str,
+        start: datetime, end: datetime,
+        admin_name: str, admin_email: str, campaign_name: str,
+    ) -> EmailResult:
+        subject, body = _format_meeting_email(
+            to_name=to_name, meet_link=meet_link, start=start, end=end,
+            admin_name=admin_name, admin_email=admin_email, campaign_name=campaign_name,
+        )
+
+        if not self.is_configured():
+            logger.warning(
+                "SMTP not fully configured (SMTP_HOST/SMTP_USER/SMTP_PASSWORD) — logging the "
+                "meeting-invite email to %s instead of sending it.\nSubject: %s\n%s",
+                to_email, subject, body,
+            )
+            return EmailResult(sent=False, to=to_email, subject=subject, is_stub=True)
+
+        msg = EmailMessage()
+        msg["Subject"] = subject
+        msg["From"] = self._sender
+        msg["To"] = to_email
+        msg.set_content(body)
+
+        with smtplib.SMTP(self._host, self._port, timeout=15) as smtp:
+            if self._use_tls:
+                smtp.starttls()
+            smtp.login(self._username, self._password)
+            smtp.send_message(msg)
+
+        return EmailResult(sent=True, to=to_email, subject=subject, is_stub=False)
+
+
+_default_sender: Optional[EmailSender] = None
+
+
+def default_sender() -> EmailSender:
+    global _default_sender
+    if _default_sender is None:
+        _default_sender = EmailSender()
+    return _default_sender
diff --git a/backend/orchestrator/meeting_scheduler.py b/backend/orchestrator/meeting_scheduler.py
